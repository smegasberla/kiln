<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!-- The updater checks a URL, and the WebView loads over the network. Without
       this the request fails at connect time, which reads like a broken server. -->
  <uses-permission android:name="android.permission.INTERNET" />
  <!-- The tray becomes a notification. Android 13 and later drops one from an app
       that does not hold this permission, without an error, so declaring it is
       necessary but not sufficient: it must also be granted at runtime. -->
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
  <application
      android:label="{{NAME}}"
      android:hasCode="true"
      android:theme="@style/Theme.Voussoir">
    <activity
        android:name=".MainActivity"
        android:configChanges="orientation|screenSize|keyboardHidden"
        android:exported="true">
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>
    </activity>
  </application>
</manifest>
