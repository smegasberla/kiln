[package]
name = "{{CRATE}}-android"
version = "0.1.0"
edition = "2021"

[lib]
name = "{{LIB}}"
crate-type = ["cdylib"]

[dependencies]
voussoir = { {{VOUSSOIR_PATH_INNER}}, features = ["full"] }
voussoir-android = { {{VOUSSOIR_ANDROID_PATH_INNER}} }
# Required by tao's and wry's android_binding! macros, which expand to items here.
tao = { version = "0.37", default-features = false }
wry = { version = "0.57" }
jni = "0.21"

[workspace]
