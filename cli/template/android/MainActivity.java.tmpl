package {{PACKAGE}};

import android.content.Intent;
import android.util.Log;
import android.view.ViewGroup;
import android.webkit.WebView;

/**
 * The activity Android launches.
 *
 * <p>Two things belong here, and both are easy to get wrong:
 *
 * <ol>
 *   <li>Loading the Rust library. It must happen before the activity's super
 *       {@code onCreate} reaches wry's native setup, so it is a static
 *       initialiser.
 *   <li>Attaching the WebView. wry creates the view and hands it to
 *       {@code onWebViewCreate}, but leaves installation to the app because only
 *       the app knows its layout. A WebView that is created but never added to the
 *       content view paints nothing, which looks exactly like a page that failed
 *       to load.
 * </ol>
 *
 * <p>Do not call the native entry point from {@code onCreate}: tao invokes it
 * itself from {@code onFirstActivityCreate}, which runs once the process
 * lifecycle starts. Calling it twice starts the event loop twice.
 *
 * <p>The desktop shell has four services Android implements differently, not
 * equivalently. Each has its own class rather than a block in this one, because
 * they share only the natives declared below:
 *
 * <ul>
 *   <li>{@link VoussoirDialogs}: {@code rfd} has no Android backend. A file picker
 *       here is a system intent, so the answer is a {@code content://} URI that
 *       has to become a path before Rust can use it.
 *   <li>{@link VoussoirMenu}: a desktop app has a menu bar, Android has none, so the
 *       menu only exists while a {@code PopupMenu} is up. That is why installing
 *       it and showing it are two separate calls.
 *   <li>{@link VoussoirTray}: there is no status area either. The tray becomes a
 *       notification whose actions are PendingIntents back into this activity.
 *   <li>{@link VoussoirHttp}: the updater's request goes through
 *       {@code HttpURLConnection} so it uses the system certificate store,
 *       which a bundled TLS stack would have to be taught separately.
 * </ul>
 *
 * <p>Every native method declared below is called <em>from</em> Java and
 * implemented in {@code android/src/lib.rs}; every {@code public void voussoir*}
 * method is called <em>from</em> Rust through JNI and implemented here. They are
 * separate directions and the names are only similar.
 */
public class MainActivity extends WryActivity {
    static final String TAG = "Voussoir";

    /** Intent extra carrying a tray item id through a notification tap. */
    static final String TRAY_EXTRA = "voussoir.tray.id";

    // Java -> Rust. Package-private rather than private: the service classes call
    // them, and JNI does not care which of the two it is.

    /** A picker answered. {@code json} is the reply shape, or null for a cancel. */
    static native void voussoirCompleteDialog(long id, String json);

    /** A picker could not be shown. Not the same thing as a cancel. */
    static native void voussoirFailDialog(long id, String message);

    static native void voussoirMenuClicked(String id);

    /**
     * A lifecycle transition: {@code resume}, {@code pause}, {@code stop}, or
     * {@code destroy}. The page hears it as {@code voussoir.listen("lifecycle", ...)}.
     *
     * <p>Reported rather than interpreted here. The shell queues a state that
     * arrives before the page can run a script, so calling this from any of the
     * overrides below is safe even before the app has started.
     */
    static native void voussoirLifecycle(String state);

    /** True when the click reached the shell, so a too-early tap can be retried. */
    static native boolean voussoirTrayClicked(String id);

    static {
        System.loadLibrary("{{LIB}}");
    }

    // One of each, because each holds state that must outlive a single call: the
    // picker holds the id it is waiting on, the menu the groups it was given, and
    // the tray whether the notification permission has already been asked for.
    private final VoussoirDialogs dialogs = new VoussoirDialogs(this);
    private final VoussoirMenu menus = new VoussoirMenu(this);
    private final VoussoirTray tray = new VoussoirTray(this);

    @Override
    public void onWebViewCreate(WebView webView) {
        Log.i(TAG, "attaching the webview");
        setContentView(webView);
        webView.setLayoutParams(new ViewGroup.LayoutParams(
                ViewGroup.LayoutParams.MATCH_PARENT,
                ViewGroup.LayoutParams.MATCH_PARENT));
    }

    @Override
    protected void onNewIntent(Intent intent) {
        super.onNewIntent(intent);
        setIntent(intent);
        tray.deliverClick();
    }

    @Override
    protected void onResume() {
        super.onResume();
        voussoirLifecycle("resume");
        // A notification tap that starts the process arrives here rather than at
        // `onNewIntent`, because this activity was created by it.
        tray.deliverClick();
    }

    @Override
    protected void onPause() {
        // Reported before super: the shell has to know the page is going away
        // while the activity is still usable, because `super.onPause` is what
        // lets the OS tear the window down.
        voussoirLifecycle("pause");
        super.onPause();
    }

    @Override
    protected void onStop() {
        voussoirLifecycle("stop");
        super.onStop();
    }

    @Override
    protected void onDestroy() {
        // A configuration change destroys the activity and recreates it, so
        // `destroy` is not process death. It is the last moment this instance can
        // report anything, and the shell queues the state either way.
        voussoirLifecycle("destroy");
        super.onDestroy();
    }

    // Rust -> Java. Every one of these may be called from any thread: the Rust
    // side calls in over JNI from whichever thread started the work, and views
    // may only be touched on the UI thread, so each hops first.

    /**
     * Show the picker described by {@code requestJson}.
     *
     * <p>{@code requestJson} is the command payload plus a {@code kind} of
     * {@code open}, {@code open_many}, {@code save}, or {@code folder}. The reply
     * is the same JSON shape the desktop dialogs return: {@code {"path": ...}},
     * {@code {"paths": [...]}}, or null for a cancel.
     */
    public void voussoirDialog(long id, String requestJson) {
        runOnUiThread(() -> dialogs.show(id, requestJson));
    }

    /** Keep the menu until {@link #voussoirShowMenu()} can put it on screen. */
    public void voussoirInstallMenu(String json) {
        menus.install(json);
    }

    /** Show the installed menu as a popup anchored on the content view. */
    public void voussoirShowMenu() {
        menus.show();
    }

    /** Post the tray configuration as a notification. */
    public void voussoirNotify(String json) {
        tray.post(json);
    }

    /**
     * Fetch a URL as text, or null if it could not be fetched.
     *
     * <p>Blocking, and must stay off the UI thread. Rust calls this from the
     * updater's worker thread, which is what makes the blocking call safe.
     */
    public String voussoirHttpGet(String url) {
        return VoussoirHttp.get(url);
    }
}
