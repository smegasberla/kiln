// Generated by voussoir. Edit freely: this is your project, not a lockfile.
//
// The dependency list is longer than it looks like it should be because wry
// generates Kotlin at build time (RustWebView, WryActivity, Ipc, ...) and that
// Kotlin needs webkit, appcompat, activity and lifecycle. None of it is optional.
plugins {
    id 'com.android.application' version '8.9.2'
    id 'org.jetbrains.kotlin.android' version '2.0.21'
}

// A release keystore is optional. `keystore.properties` at the project root (or
// the VOUSSOIR_KEYSTORE* environment variables) supplies a real key; without one the
// release variant is signed with the debug key, so a fresh scaffold and CI can
// still produce an `.aab`. Play refuses a debug-signed bundle, which is a
// clearer signal than Gradle refusing to build before anyone owns a key.
def voussoirKeystore = new Properties()
def voussoirKeystoreFile = rootProject.file("keystore.properties")
if (voussoirKeystoreFile.exists()) {
    voussoirKeystoreFile.withInputStream { voussoirKeystore.load(it) }
}
def voussoirStoreFile = voussoirKeystore.getProperty("storeFile") ?: System.getenv("VOUSSOIR_KEYSTORE")
def voussoirHasKeystore = voussoirStoreFile != null

android {
    namespace '{{PACKAGE}}'
    compileSdk 36

    defaultConfig {
        applicationId "{{PACKAGE}}"
        minSdk 26
        targetSdk 36
        versionCode 1
        versionName "0.1.0"

        // The instrumentation tests in src/androidTest are the only way to run
        // the picker and menu translations on a real Android runtime.
        testInstrumentationRunner "androidx.test.runner.AndroidJUnitRunner"
    }

    signingConfigs {
        release {
            if (voussoirHasKeystore) {
                storeFile file(voussoirStoreFile)
                storePassword voussoirKeystore.getProperty("storePassword") ?: System.getenv("VOUSSOIR_KEYSTORE_PASSWORD")
                keyAlias voussoirKeystore.getProperty("keyAlias") ?: System.getenv("VOUSSOIR_KEY_ALIAS")
                keyPassword voussoirKeystore.getProperty("keyPassword") ?: System.getenv("VOUSSOIR_KEY_PASSWORD")
            }
        }
    }

    buildTypes {
        release {
            // Debug signing when no keystore was configured above.
            signingConfig voussoirHasKeystore ? signingConfigs.release : signingConfigs.debug
        }
    }

    compileOptions {
        sourceCompatibility JavaVersion.VERSION_17
        targetCompatibility JavaVersion.VERSION_17
    }

    kotlinOptions {
        jvmTarget = '17'
    }

    buildFeatures {
        // wry's generated Logger.kt reads BuildConfig.DEBUG.
        buildConfig true
    }

    sourceSets {
        main {
            // The Rust .so is staged here by `voussoir android build`.
            jniLibs.srcDirs = ['src/main/jniLibs']
            java.srcDirs += ['src/main/kotlin']
        }
    }
}

dependencies {
    implementation 'androidx.webkit:webkit:1.12.1'
    implementation 'androidx.appcompat:appcompat:1.7.0'
    implementation 'androidx.activity:activity:1.9.3'
    implementation 'androidx.lifecycle:lifecycle-process:2.8.7'
    // NotificationCompat, for the tray notification the Rust side posts.
    implementation 'androidx.core:core:1.13.1'

    androidTestImplementation 'androidx.test:runner:1.6.2'
    // ActivityScenario, for the rotation test: it launches the real activity and
    // lets the test read the same instance back rather than a copy.
    androidTestImplementation 'androidx.test:core:1.6.1'
    androidTestImplementation 'androidx.test.ext:junit:1.2.1'
}
