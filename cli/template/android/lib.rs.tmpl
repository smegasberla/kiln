//! Android entry point for {{NAME}}.
//!
//! The counterpart of `native/src/main.rs`: same app, same commands. The only
//! difference is that the activity owns the event loop instead of `main`.
//!
//! `register_jni!` installs the symbols wry's generated Kotlin calls. It must run
//! inside a function because tao's macro expands to a block, which Rust rejects at
//! module scope; `#[no_mangle]` still exports from within a function.

use kiln::serde_json::{json, Value};
use kiln::{App, AppHandle};

mod assets;

/// The activity's native entry point, named as JNI expects.
#[no_mangle]
pub extern "C" fn Java_{{JNI_PACKAGE}}_MainActivity_android_1main(
    _env: jni::JNIEnv,
    _class: jni::objects::JClass,
) {
    android_main();
}

fn android_main() {
    kiln_android::register_jni!({{DOMAIN}}, {{LEAF}}, Rust, android_main);

    // The same command set as `native/src/main.rs`. The frontend is shared, so a
    // command registered on only one platform is a missing command at runtime;
    // `kiln android build` warns when the two lists differ.
    kiln_android::run(
        App::new()
            .config(include_str!("../../kiln.json"))
            .assets(assets::ASSETS)
            .command("greet", |_app, payload: Value| {
                let name = payload
                    .get("name")
                    .and_then(Value::as_str)
                    .unwrap_or("world");
                Ok(json!(format!("Hello, {name}! (from Rust)")))
            })
            // Async work runs off the UI thread, so a slow job cannot freeze the
            // page while the reply is pending.
            .async_command("slow_task", |_app, payload: Value| {
                let ms = payload.get("ms").and_then(Value::as_u64).unwrap_or(500);
                std::thread::sleep(std::time::Duration::from_millis(ms));
                Ok(json!({ "slept_ms": ms }))
            })
            // Android is one window by design, so this reports why rather than
            // silently doing nothing: a second window has nowhere to go.
            .command("open_settings", |_app: &AppHandle, _payload| {
                Err(kiln::Error::Handler(
                    "second windows are desktop-only; use an in-page panel on Android"
                        .to_owned(),
                ))
            }),
    )
}

// Java -> Rust. `MainActivity` calls these when a picker returns, when a popup
// menu item is tapped, and when a notification action is tapped. Their names are
// the activity's method names behind JNI's `Java_<package>_<class>_` prefix, and
// none of those method names contains an underscore, so no `_1` escaping shows
// up here; the package half of the name is already escaped by `{{JNI_PACKAGE}}`.
//
// They live in the app rather than in `kiln-android` because the prefix names
// the app's own package, which the library cannot know.

/// A Java string as Rust text, or `None` when it was null or unreadable.
///
/// An unreadable id is dropped rather than turned into `""`: an empty id names
/// no menu item, so letting one through would emit a click on nothing.
fn text_of(env: &mut jni::JNIEnv, value: &jni::objects::JString) -> Option<String> {
    if value.is_null() {
        return None;
    }
    env.get_string(value).ok().map(String::from)
}

/// The picker answered. `json` is the desktop dialogs' reply shape, or null for
/// a cancel, which `kilnCompleteDialog` passes through as such.
#[no_mangle]
pub extern "C" fn Java_{{JNI_PACKAGE}}_MainActivity_kilnCompleteDialog(
    mut env: jni::JNIEnv,
    _class: jni::objects::JClass,
    id: jni::sys::jlong,
    json: jni::objects::JString,
) {
    kiln::complete_dialog(id as u64, text_of(&mut env, &json));
}

/// The picker could not be shown at all, which is not the same as a cancel.
#[no_mangle]
pub extern "C" fn Java_{{JNI_PACKAGE}}_MainActivity_kilnFailDialog(
    mut env: jni::JNIEnv,
    _class: jni::objects::JClass,
    id: jni::sys::jlong,
    message: jni::objects::JString,
) {
    let message = text_of(&mut env, &message)
        .unwrap_or_else(|| "the file picker could not be shown".to_owned());
    kiln::fail_dialog(id as u64, &message);
}

#[no_mangle]
pub extern "C" fn Java_{{JNI_PACKAGE}}_MainActivity_kilnMenuClicked(
    mut env: jni::JNIEnv,
    _class: jni::objects::JClass,
    id: jni::objects::JString,
) {
    if let Some(id) = text_of(&mut env, &id) {
        kiln::menu_clicked(&id);
    }
}

/// A lifecycle transition the activity reported: `resume`, `pause`, `stop`, or
/// `destroy`.
///
/// Queued rather than answered, and never dropped. tao starts the event loop on
/// its own thread, so the first `resume` arrives before `App::run` has published
/// a handle and before the page can run a script; `kiln::lifecycle` keeps the
/// states until the page has loaded.
#[no_mangle]
pub extern "C" fn Java_{{JNI_PACKAGE}}_MainActivity_kilnLifecycle(
    mut env: jni::JNIEnv,
    _class: jni::objects::JClass,
    state: jni::objects::JString,
) {
    if let Some(state) = text_of(&mut env, &state) {
        kiln::lifecycle(&state);
    }
}

/// True when the click reached the shell.
///
/// A notification can start the process, and the tap then resumes the activity
/// before `App::run` has published its handle; `tray_clicked` drops an event it
/// has no loop to send to, so the answer here is whether that loop exists. The
/// activity keeps the intent extra and tries again on the next resume.
#[no_mangle]
pub extern "C" fn Java_{{JNI_PACKAGE}}_MainActivity_kilnTrayClicked(
    mut env: jni::JNIEnv,
    _class: jni::objects::JClass,
    id: jni::objects::JString,
) -> jni::sys::jboolean {
    let Some(id) = text_of(&mut env, &id) else {
        return jni::sys::JNI_FALSE;
    };
    if kiln::runtime().is_none() {
        return jni::sys::JNI_FALSE;
    }
    kiln::tray_clicked(&id);
    jni::sys::JNI_TRUE
}
