//! {{NAME}} - a Kiln desktop app.
//!
//! Everything shipped is here: the windows and the embedded frontend bytes.
//! Commands live in the `commands` crate beside this file — release links them
//! statically into this binary, `kiln dev` hot-reloads them from a cdylib.
//! `cargo build --release` produces the whole app.

#[cfg(not(feature = "hot-reload"))]
use commands::{commands, Kind};
use kiln::{App, AppHandle, Error, WindowOptions};

mod assets;

/// Arguments for `open_settings`.
///
/// The shell-side commands take real types: a page that sends a string where a
/// number belongs gets a `payload` rejection naming the command, instead of a
/// silently ignored field that looks like a UI bug. Types come from the
/// re-exported `serde`, so this needs no extra dependency.
#[derive(Debug, Default, kiln::serde::Deserialize)]
#[serde(crate = "kiln::serde")]
struct SettingsArgs {
    /// Window title. Omitted by pages that just want the default.
    #[serde(default)]
    title: Option<String>,
}

fn main() -> Result<(), Error> {
    let mut app = App::new()
        .config(include_str!("../../kiln.json"))
        .assets(assets::ASSETS)
        // Shell-service commands stay in the shell: they take an
        // `&AppHandle`, and a handle type cannot cross the cdylib boundary
        // soundly, so they register statically in dev and release alike.
        .command_typed("open_settings", |app: &AppHandle, args: SettingsArgs| {
            let label = app.open_window(WindowOptions {
                label: Some("settings".to_owned()),
                title: Some(args.title.unwrap_or_else(|| "Settings".to_owned())),
                width: Some(420.0),
                height: Some(320.0),
                entry: None,
                // A settings window needs no command surface of its own; it
                // reports back through events. Narrowing is how a window that
                // renders untrusted content is kept away from the rest.
                allowlist: None,
            })?;
            app.emit_to(Some(&label), "settings:opened", kiln::serde_json::json!(null));
            Ok(())
        })
        // Keep devtools available in the build your users run (F12).
        .devtools(true);

    // Release: the table links in statically. Dev (`--features hot-reload`,
    // set up by `kiln dev`): the table lives in the dylib instead, so a stale
    // copy in this binary can never shadow what you just edited.
    #[cfg(not(feature = "hot-reload"))]
    for command in commands() {
        // Deliberately written as an associated call rather than
        // `app.command(…)`: the parity checker reads command names from the
        // `name: "…"` literals in the commands crate, and this loop must not
        // look like a registration whose name it cannot read.
        app = match command.kind {
            Kind::Sync => App::command(app, command.name, |_app, payload| {
                (command.run)(&payload).map_err(kiln::Error::Handler)
            }),
            Kind::Async => App::async_command(app, command.name, |_app, payload| {
                (command.run)(&payload).map_err(kiln::Error::Handler)
            }),
        };
    }

    #[cfg(feature = "hot-reload")]
    {
        app = app.hot_commands_from_env();
    }

    app.run()
}
