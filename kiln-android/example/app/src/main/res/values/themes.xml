<?xml version="1.0" encoding="utf-8"?>
<resources>
  <!--
    wry's WryActivity extends AppCompatActivity, which refuses to start unless the
    activity theme is (or descends from) a Theme.AppCompat theme. NoActionBar keeps
    the webview edge-to-edge; the page owns its own chrome.
  -->
  <style name="Theme.Kiln" parent="Theme.AppCompat.DayNight.NoActionBar">
    <item name="android:windowBackground">@android:color/white</item>
  </style>
</resources>
